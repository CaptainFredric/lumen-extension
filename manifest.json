{
  "manifest_version": 3,
  "name": "Lumen",
  "version": "0.5.0",
  "description": "Capture full pages or selected areas, then copy, annotate, compare, redact, and export from a private workspace.",
  "homepage_url": "https://captainfredric.github.io/lumen-extension/",
  "minimum_chrome_version": "109",
  "options_page": "settings.html",
  "permissions": [
    "activeTab",
    "alarms",
    "downloads",
    "offscreen",
    "scripting",
    "storage"
  ],
  "optional_permissions": [
    "identity"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_title": "Lumen",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "capture-page": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L"
      },
      "description": "Capture the current page with Lumen"
    },
    "capture-visible-area": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "mac": "Alt+Shift+V"
      },
      "description": "Capture the visible area with Lumen"
    },
    "capture-area": {
      "suggested_key": {
        "default": "Alt+Shift+X",
        "mac": "Alt+Shift+A"
      },
      "description": "Select and capture an area with Lumen"
    }
  }
}

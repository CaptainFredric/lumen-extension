{
  "manifest_version": 3,
  "name": "Lumen",
  "version": "0.2.0",
  "description": "Local full-page and lasso capture with redaction, responsive views, a photo library, and selected-area monitors.",
  "homepage_url": "https://captainfredric.github.io/lumen-extension/",
  "minimum_chrome_version": "109",
  "permissions": [
    "activeTab",
    "alarms",
    "downloads",
    "offscreen",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_title": "Lumen",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
